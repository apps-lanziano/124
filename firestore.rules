rules_version = '2';

/*
  כללי אבטחה ל-Firestore — טייסת 124
  ------------------------------------
  כל נתוני האפליקציה יושבים באוסף אחד: sq124. כל רשומה היא מסמך בודד
  ששמו הוא המפתח (למשל "shed3_cfg_personnel"). האפליקציה תמיד קוראת
  מסמך בודד לפי מפתח מדויק — היא לעולם לא מבצעת שאילתת רשימה (list).

  ── גרסה 3 (מה שמופעל כאן) ─────────────────────────────────────────
  סוגרת את פרצת האימות האנונימי: אימות אנונימי (מופעל אוטומטית בטעינת
  כל דף, לפני הקלדת קוד) היה עובר את בדיקת האימות הבסיסית (isAuthed,
  גרסה 1 הישנה) בדיוק כמו כניסה אמיתית — כך שמי שפתח את האתר האמיתי
  בלבד (בלי קוד, ב-F12) יכול היה לקרוא/לכתוב את כל המסד. אומת בפועל
  ותועד ב-2026-08-04 — ראה SECURITY.md שלב 7.

  הפתרון: תגית authorized:true שמצמידה Cloud Function (markAuthorized,
  functions/index.js) לחשבון — רק לאחר שווידאה בעצמה בצד השרת (לא
  סומכת על הלקוח) שזו כניסה אמיתית עם קוד (sign_in_provider==="password"),
  לא אימות אנונימי. הלקוח קורא לה מיד אחרי כניסה מוצלחת (checkCode →
  markSessionAuthorized). כללי sq124 למטה דורשים את התגית בנוסף לאימות
  עצמו — אימות אנונימי-בלבד (שלא קרא ל-markAuthorized) נחסם.

  ── גרסה 1 הישנה (isAuthed בלבד, בלי דרישת תגית) — היסטורי ──────────
  שכבת הבסיס שהייתה פעילה לפני גרסה 3: חובת אימות + בלי list + מחיקה
  דורשת אימות. עדיין רלוונטית כתשתית (App Check + חובת אימות), אבל
  isAuthed() לבדו כבר לא מספיק — ראה גרסה 3 למעלה.

  ── גרסה 2 (למטה) — לא בשימוש, לא לפרסם ────────────────────────────
  נכתבה לפני שהכניסה עברה ל-CODE_LOGIN="server": אז כל חשבון היה
  "shed3.cmd@sq124.app" וניתן היה לגזור מסגרת מהאימייל. היום כל חשבון
  הוא "u<קוד>@sq124.app" (לא חושף מסגרת, בכוונה) — לכן הכלל למטה יזהה
  את כולם כ"לא שייכים לאף מסגרת" ו**ינעל את כל הטייסת בחוץ אם יפורסם**.
  בנוסף — הוחלט לא לבצע הפרדת מסגרות בשרת (החשש אינו מפני אנשי הטייסת
  עצמם). נשאר כתיעוד היסטורי בלבד. ראה SECURITY.md שלב 4.
*/

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() {
      return request.auth != null;
    }
    function isAuthorized() {
      return request.auth != null && request.auth.token.authorized == true;
    }
    // מסמכים רגישים: admin_*, authprofile_*, ai_quota_*, push_tokens_*
    // כתיבה/מחיקה מוגבלת למפקד בלבד (role claim נקבע server-side ע"י markAuthorized).
    // push_tokens: מערך קודי התקעים של כל משתמש — רק מנהל יכול לערוך לכל הטייסת
    function isSensitiveDoc(docId) {
      return docId.matches('^(admin_|authprofile_|ai_quota_|push_tokens_).*');
    }
    // תפקיד בעל הרשאה גבוהה — role claim מוטמע ע"י markAuthorized, לא נקבע ע"י הלקוח
    function isPrivileged() {
      return isAuthorized() && request.auth.token.role == "מפקד";
    }

    match /sq124/{docId} {
      allow get:            if isAuthorized();
      allow create, update: if isAuthorized() && (!isSensitiveDoc(docId) || isPrivileged());
      allow delete:         if isAuthorized() && (!isSensitiveDoc(docId) || isPrivileged());
      allow list:           if false;           // בלי שאיבה המונית של כל המסד
    }

    // כל שאר האוספים — סגורים.
    match /{document=**} {
      allow read, write: if false;
    }

    /* ── גרסה 1 הישנה — isAuthed בלבד, בלי דרישת תגית authorized (ראו
       ההערה למעלה) — נשאר כתיעוד היסטורי בלבד, לא לפרסם. ──
    match /sq124/{docId} {
      allow get:            if isAuthed();
      allow create, update: if isAuthed();
      allow delete:         if isAuthed();
      allow list:           if false;
    }
    */

    /* ── גרסה 2 — הפרדה בין מסגרות (להחליף את הבלוק של sq124 שלמעלה) ──
       מודל: "חסום מסגרות אחרות, התר את השאר". הנתונים הפרטיים של כל מסגרת
       נשמרים עם קידומת המסגרת (shed3_, dept_, maint_, training_ ...), ולכן
       מסגרת אחת אינה יכולה לקרוא אותם של אחרת. מסמכים משותפים בכוונה
       (admin_*, vo_licenses_list, binui_faults_list, boards וכו') אינם נושאים
       קידומת מסגרת ולכן נשארים נגישים לכל מאומת — כפי שהאפליקציה מצפה.

    function myPrefix() {
      // "shed3.cmd@sq124.app" -> "shed3_"
      return request.auth.token.email.split('@')[0].split('.')[0] + '_';
    }
    function isSquadronWide() {
      // רואים את כל הטייסת: מנהל מערכת / קצין טכני / אחראי תקציבים,
      // וכן מפקדי "הדרכה" ו"מ״ע אחזקה" (הם ורק הם — לא חיילי המסגרות).
      return isAuthed() && (
        request.auth.token.email.matches('^(owner|tech|budget)@.*')
        || request.auth.token.email.matches('^(training|maint)[.]cmd@.*')
      );
    }
    function isOtherFrameworkDoc(docId) {
      // מסמך ששייך למסגרת כלשהי אך לא לשלי
      return docId.matches('^(shed[0-9]+|dept|maint|training)_.*')
             && !docId.matches('^' + myPrefix() + '.*');
    }
    match /sq124/{docId} {
      allow get, create, update, delete:
        if isSquadronWide()
        || (isAuthed() && !isOtherFrameworkDoc(docId));
      allow list: if false;
    }
    */
  }
}
