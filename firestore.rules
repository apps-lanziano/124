rules_version = '2';

/*
  כללי אבטחה ל-Firestore — טייסת 124
  ------------------------------------
  כל נתוני האפליקציה יושבים באוסף אחד: sq124. כל רשומה היא מסמך בודד
  ששמו הוא המפתח (למשל "shed3_cfg_personnel"). האפליקציה תמיד קוראת
  מסמך בודד לפי מפתח מדויק — היא לעולם לא מבצעת שאילתת רשימה (list).

  ── גרסה 1 (מה שמופעל כאן) ─────────────────────────────────────────
  שלוש שכבות שסוגרות את הפרצה הקריטית שהודגמה (המסד היה קריא ומחיק
  מהאינטרנט הפתוח, בלי שום התחברות):
    1. חובת אימות — בלי התחברות אין גישה לשום נתון (קריאה, כתיבה או מחיקה).
    2. בלי list   — אי אפשר לשאוב את כל המסד בבקשה אחת.
    3. מחיקה דורשת אימות — האפליקציה מוחקת תמונות/קבצים, ולכן מחיקה מותרת
       למחובר בלבד; מחיקה חיצונית נחסמת גם ע"י האימות וגם ע"י App Check.

  גרסה 1 עובדת עם כל מודל חשבונות (אפילו חשבון אפליקציה יחיד) ומשתלבת
  עם אכיפת App Check שיש להפעיל בנפרד בקונסולה. שילוב השניים חזק:
  האימות מוודא "מי", ו-App Check מוודא "מאיפה" (מהאתר האמיתי בלבד).

  ── גרסה 2 (למטה) — לא בשימוש, לא לפרסם ────────────────────────────
  נכתבה לפני שהכניסה עברה ל-CODE_LOGIN="server": אז כל חשבון היה
  "shed3.cmd@sq124.app" וניתן היה לגזור מסגרת מהאימייל. היום כל חשבון
  הוא "u<קוד>@sq124.app" (לא חושף מסגרת, בכוונה) — לכן הכלל למטה יזהה
  את כולם כ"לא שייכים לאף מסגרת" ו**ינעל את כל הטייסת בחוץ אם יפורסם**.
  בנוסף — הוחלט לא לבצע הפרדת מסגרות בשרת (החשש אינו מפני אנשי הטייסת
  עצמם). נשאר כתיעוד היסטורי בלבד. ראה SECURITY.md שלב 4.

  ── גרסה 3 (למטה) — סוגרת את פרצת האימות האנונימי, ⚠️ עדיין לא לפרסם ──
  אימות אנונימי (מופעל אוטומטית בטעינת כל דף, לפני הקלדת קוד) עובר את
  isAuthed() בדיוק כמו כניסה אמיתית — כך שמי שפותח את האתר האמיתי בלבד
  (בלי קוד, בלי F12 חכם) יכול לקרוא/לכתוב את כל המסד. הפתרון: תגית
  authorized:true שמצמידה Cloud Function (markAuthorized, פרוסה ופעילה)
  רק לכניסה אמיתית עם קוד — לא לאימות אנונימי. הלקוח כבר קורא לה בכל
  כניסה (checkCode → markSessionAuthorized), אבל הכלל למטה **עדיין לא
  הופעל**: קודם צריך לוודא בפועל (כניסה חיה + בדיקת ה-custom claim,
  למשל דרך getIdTokenResult() בקונסולת הדפדפן) שהתגית אכן נקלטת, ורק
  אז להחליף את בלוק ה-sq124 למעלה בבלוק הזה ולפרסם. אם יפורסם לפני
  שהתגית מאומתת בפועל — כל מי שכבר מחובר (כולל אימות אנונימי שלא
  שודרג) ייחסם עד כניסה מחדש.
*/

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() {
      return request.auth != null;
    }

    match /sq124/{docId} {
      allow get:            if isAuthed();
      allow create, update: if isAuthed();
      allow delete:         if isAuthed();  // האפליקציה מוחקת תמונות/קבצים — חייב אימות
      allow list:           if false;       // בלי שאיבה המונית של כל המסד
    }

    // כל שאר האוספים — סגורים.
    match /{document=**} {
      allow read, write: if false;
    }

    /* ── גרסה 2 — הפרדה בין מסגרות (להחליף את הבלוק של sq124 שלמעלה) ──
       מודל: "חסום מסגרות אחרות, התר את השאר". הנתונים הפרטיים של כל מסגרת
       נשמרים עם קידומת המסגרת (shed3_, dept_, maint_, training_ ...), ולכן
       מסגרת אחת אינה יכולה לקרוא אותם של אחרת. מסמכים משותפים בכוונה
       (admin_*, vo_licenses_list, binui_faults_list, boards וכו') אינם נושאים
       קידומת מסגרת ולכן נשארים נגישים לכל מאומת — כפי שהאפליקציה מצפה.

    function myPrefix() {
      // "shed3.cmd@sq124.app" -> "shed3_"
      return request.auth.token.email.split('@')[0].split('.')[0] + '_';
    }
    function isSquadronWide() {
      // רואים את כל הטייסת: מנהל מערכת / קצין טכני / אחראי תקציבים,
      // וכן מפקדי "הדרכה" ו"מ״ע אחזקה" (הם ורק הם — לא חיילי המסגרות).
      return isAuthed() && (
        request.auth.token.email.matches('^(owner|tech|budget)@.*')
        || request.auth.token.email.matches('^(training|maint)[.]cmd@.*')
      );
    }
    function isOtherFrameworkDoc(docId) {
      // מסמך ששייך למסגרת כלשהי אך לא לשלי
      return docId.matches('^(shed[0-9]+|dept|maint|training)_.*')
             && !docId.matches('^' + myPrefix() + '.*');
    }
    match /sq124/{docId} {
      allow get, create, update, delete:
        if isSquadronWide()
        || (isAuthed() && !isOtherFrameworkDoc(docId));
      allow list: if false;
    }
    */

    /* ── גרסה 3 — דורשת את תגית authorized:true (להחליף את בלוק ה-sq124
       של גרסה 1 למעלה, רק אחרי אימות חי — ראו ההערה למעלה) ──

    function isAuthorized() {
      return request.auth != null && request.auth.token.authorized == true;
    }
    match /sq124/{docId} {
      allow get:            if isAuthorized();
      allow create, update: if isAuthorized();
      allow delete:         if isAuthorized();
      allow list:           if false;
    }
    */
  }
}
